# At least one search provider is required.
EXA_API_KEY=
TAVILY_API_KEY=

# Optional Google discovery providers used only by the separate Google 추가 찾기 button.
SERPER_API_KEY=
SERPAPI_API_KEY=

# Supabase candidate deduplication store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DM personalization LLMs. Groq is primary; Scaleway is automatic fallback.
GROQ_API_KEY=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
DM_LLM_TIMEOUT_MS=10000

# Local OpenCode executable used by the UI automation button.
OPENCODE_COMMAND=opencode

# FixUp Scout OpenCode provider fallback. Keep real API key values only in .env.local.
MISTRAL_API_KEY=
NVIDIA_API_KEY=
FIXUP_OPENCODE_PRIMARY_MODEL=opencode/muse-spark-1.2-contributor-free
FIXUP_OPENCODE_NEMOTRON_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
FIXUP_OPENCODE_VERCEL_MODEL=vercel/alibaba/qwen3.8-27b
FIXUP_OPENCODE_GLM53_MODEL=zai-coding-plan/glm-5.3-flash
FIXUP_OPENCODE_VENICE_MODEL=venice/stealth-ox-alpha
FIXUP_OPENCODE_GLM47_MODEL=zai-coding-plan/glm-4.7
FIXUP_OPENCODE_STALL_SECONDS=75
FIXUP_OPENCODE_MAX_RETRY_AFTER_SECONDS=15

# Search tuning
DISCOVERY_TIMEOUT_MS=12000
DISCOVERY_CONCURRENCY=4
