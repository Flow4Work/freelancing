# At least one search provider is required.
EXA_API_KEY=
TAVILY_API_KEY=

# Supabase candidate deduplication store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DM personalization LLMs. Groq is primary; Scaleway is automatic fallback.
GROQ_API_KEY=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
DM_LLM_TIMEOUT_MS=10000

# Local OpenCode executable used by the UI automation button.
OPENCODE_COMMAND=opencode

# Search tuning
DISCOVERY_TIMEOUT_MS=12000
DISCOVERY_CONCURRENCY=4
